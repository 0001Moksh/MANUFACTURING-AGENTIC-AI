# Database configurations
# If left blank, it will automatically default to local SQLite: sqlite+aiosqlite:///./mai_platform.db
# For PostgreSQL (Docker Compose): postgresql+asyncpg://postgres:postgres@db:5432/mai_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/mai_db
CONSTRUCTION_DB_URL=postgresql://postgres:postgres@db:5432/construction_ai
INFLUXDB_URL=http://192.168.10.130:8086
INFLUXDB_TOKEN=CHANGE_ME_INFLUXDB_TOKEN
INFLUXDB_ORG=IIIOT-INFOTECH
INFLUXDB_BUCKET=ECE2
INFLUX_TELEMETRY_RANGE=30d
INFLUX_MACHINE_NAME=Live InfluxDB Equipment
INFLUX_MACHINE_CODE=INFLUX-01
INFLUX_DEVICE_ID=
INFLUX_TEMPERATURE_MEASUREMENT=electrical_params
INFLUX_TEMPERATURE_FIELD=Temperature
INFLUX_VIBRATION_MEASUREMENT=electrical_params
INFLUX_VIBRATION_FIELD=Vibration
INFLUX_CURRENT_MEASUREMENT=electrical_params
INFLUX_CURRENT_FIELD=Current_AVG
INFLUX_POWER_MEASUREMENT=electrical_params
INFLUX_POWER_FIELD=Power
INFLUX_RPM_MEASUREMENT=electrical_params
INFLUX_RPM_FIELD=RPM
CAMERA_ENCRYPTION_KEY=A7lbQlcJSmFqVM_cDnCMke2vGH356K5t-JbezmZmieU=
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STARTUP_TIMEOUT_SECONDS=30
# Keep false outside local development. Report and log files must not restart the server.
APP_RELOAD=false
FRONTEND_URL=http://localhost:3000

# Customer license validation configuration
# Supply the public verification key for the private license server.
# Never include the private signing key in the MAI runtime or repository.
MAI_LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
PASTE_YOUR_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----
MAI_LICENSE_FILE=./licenses/customer.lic
MAI_LICENSE_GRACE_DAYS=7

# LLM Providers Configuration
# You must provide at least one valid key to execute queries in the LangGraph agent
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
